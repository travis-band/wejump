# Copy this file to .env and use that:  cp .env.example .env
# .env is listed in .gitignore, so it never goes to git. Passwords go only in .env!

# Database address for local development (the Postgres started with docker compose up -d db)
#            driver       user   password  host      port database
DATABASE_URL=postgresql://wejump:localdev@localhost:5432/wejump_deployment

APP_COLOR=local

# The key that signs the login cookie. Any value works on your computer.
# Real servers use a long random one:  openssl rand -hex 32
SESSION_SECRET=local-dev-only-secret

# GitHub login. Make an OAuth App with the callback URL http://localhost:8000/auth/callback
# (GitHub → Settings → Developer settings → OAuth Apps, see docs/08-login.md) and paste its values here.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

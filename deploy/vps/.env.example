# 서버의 /opt/wejump/deploy/vps/.env 에 들어갈 내용의 예시입니다.
# 보통은 setup.sh가 자동으로 만들어 줍니다. 이 파일(.env)은 서버 밖으로 나가면 안 됩니다.

# 사이트 주소. Caddy가 이 이름으로 HTTPS 인증서를 받습니다.
DOMAIN=wejump.duckdns.org

# GitHub Actions가 만들어 올린 이미지 주소 (소문자여야 함)
IMAGE=ghcr.io/your-github-id/wejump

# DB 비밀번호. setup.sh가 무작위로 만들어 줍니다. 아무에게도 보여주지 마세요.
POSTGRES_PASSWORD=change-me

# 아래 두 줄은 deploy.sh가 배포할 때마다 자동으로 고쳐 씁니다.
BLUE_TAG=
GREEN_TAG=

# (선택) 포트를 바꾸고 싶을 때. 내 컴퓨터에서 연습할 때만 씁니다.
# HTTP_PORT=8080
# HTTPS_PORT=8443

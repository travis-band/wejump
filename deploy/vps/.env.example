# An example of what goes in /opt/wejump/deploy/vps/.env on the server.
# Usually setup.sh creates it for you. This file (.env) must never leave the server.

# The site address. Caddy gets the HTTPS certificate for this name.
DOMAIN=wejump.duckdns.org

# The address of the image GitHub Actions built and pushed (must be lowercase)
IMAGE=ghcr.io/your-github-id/wejump

# Database password. setup.sh generates a random one. Don't show it to anyone.
POSTGRES_PASSWORD=change-me

# deploy.sh rewrites the two lines below automatically on every deploy.
BLUE_TAG=
GREEN_TAG=

# (Optional) to change the ports. Only used when practicing on your own computer.
# HTTP_PORT=8080
# HTTPS_PORT=8443

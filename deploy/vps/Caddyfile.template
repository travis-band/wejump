# deploy.sh copies this file to create the Caddyfile.
#   __DOMAIN__ → DOMAIN from .env   (e.g. wejump.duckdns.org)
#   __COLOR__  → blue or green      (the slot that receives traffic now)
#
# Just write the domain name, and Caddy gets an HTTPS certificate from Let's Encrypt on its own.
# For the load-balancing experiment, see docs/05-blue-green.md (two upstreams + lb_policy round_robin).

__DOMAIN__ {
	reverse_proxy app-__COLOR__:8000
}
